MYSQL_PASSWORD=changeme_strong_password
MYSQL_ROOT_PASSWORD=changeme_very_strong_root_password
DB_HOST=db
DB_PORT=3306

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
