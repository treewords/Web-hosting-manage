# Backend Configuration
BACKEND_PORT=4000

# JWT Configuration
# IMPORTANT: Use a long, random, and secret string for production!
JWT_SECRET=changeme_this_is_not_secure
JWT_EXPIRES_IN=1d

# Database Configuration (MariaDB/MySQL)
